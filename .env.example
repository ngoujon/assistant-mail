# Clé utilisée pour chiffrer (AES-256-GCM) les mots de passe IMAP/SMTP en base.
# Si vous la changez, les comptes existants devront être ressaisis.
APP_SECRET=changez-cette-cle-secrete-tres-longue

# Mot de passe d'accès à l'interface web (laisser vide pour désactiver l'authentification)
APP_PASSWORD=

# Ollama local
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Port d'écoute
PORT=3016

# Répertoire de stockage (base SQLite, mails bruts, sauvegardes)
DATA_DIR=./data

# Nombre maximum de messages téléchargés par dossier lors d'une synchro (0 = illimité)
MAX_MESSAGES_PER_FOLDER=0
